            "name": "id",
            "in": "path",
            "description": "The Scryfall ID of the card",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "example": "683a5707-cddb-494d-9b41-51b4584ded69"
          }
        ],
        "responses": {
          "200": {
            "description": "Card found",
            "content": {
              "application/json": {
                "schema": {
