  "components": {
    "schemas": {
      "Card": {
        "type": "object",
        "description": "Card objects represent individual Magic: The Gathering cards",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "A unique ID for this card in Scryfall's database"
          },
          "oracle_id": {
            "type": "string",
            "format": "uuid",
            "description": "A unique ID for this card's oracle identity"
          },
          "name": {
            "type": "string",
            "description": "The name of this card"
          },
          "lang": {
            "type": "string",
            "description": "The language code for this printing"
          },
          "released_at": {
            "type": "string",
            "format": "date",
            "description": "The date this card was first released"
          },
          "uri": {
            "type": "string",
            "format": "uri",
            "description": "A link to this card object on Scryfall's API"
          },
          "scryfall_uri": {
            "type": "string",
            "format": "uri",
            "description": "A link to this card's page on Scryfall's website"
          },
          "layout": {
            "type": "string",
            "description": "A code for this card's layout"
          },
          "mana_cost": {
            "type": "string",
            "description": "The mana cost for this card"
          },
          "cmc": {
            "type": "number",
            "description": "The card's converted mana cost"
          },
          "type_line": {
            "type": "string",
            "description": "The type line of this card"
          },
          "oracle_text": {
            "type": "string",
            "description": "The Oracle text for this card"
          },
          "colors": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "This card's colors"
          },
          "color_identity": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "This card's color identity"
          },
          "set": {
            "type": "string",
            "description": "This card's set code"
          },
          "set_name": {
            "type": "string",
            "description": "This card's full set name"
          },
          "collector_number": {
            "type": "string",
            "description": "This card's collector number"
          },
          "rarity": {
            "type": "string",
            "enum": [
              "common",
              "uncommon",
              "rare",
              "mythic",
              "special",
              "bonus"
            ],
            "description": "This card's rarity"
          },
          "artist": {
            "type": "string",
            "description": "The name of the illustrator of this card"
          },
          "image_uris": {
            "type": "object",
            "description": "An object containing URIs to this card's imagery",
            "properties": {
              "small": {
                "type": "string",
                "format": "uri"
              },
              "normal": {
                "type": "string",
                "format": "uri"
              },
              "large": {
                "type": "string",
                "format": "uri"
              },
              "png": {
                "type": "string",
                "format": "uri"
              },
              "art_crop": {
                "type": "string",
                "format": "uri"
              },
              "border_crop": {
                "type": "string",
                "format": "uri"
              }
            }
          },
          "prices": {
            "type": "object",
            "description": "An object containing daily price information for this card",
            "properties": {
              "usd": {
                "type": "string",
                "nullable": true
              },
              "usd_foil": {
                "type": "string",
                "nullable": true
              },
              "eur": {
                "type": "string",
                "nullable": true
              },
              "tix": {
                "type": "string",
                "nullable": true
              }
            }
          },
          "legalities": {
            "type": "object",
            "description": "An object describing the legality of this card",
            "additionalProperties": {
              "type": "string",
              "enum": [
                "legal",
                "not_legal",
                "restricted",
