{
  "openapi": "3.0.3",
  "info": {
    "title": "Scryfall API",
    "description": "Scryfall provides a REST-like API for accessing Magic: The Gathering card data programmatically. It offers endpoints to retrieve cards, sets, images, and other related data in an easy-to-consume format.",
    "version": "1.0.0",
    "contact": {
      "name": "Scryfall Support",
      "url": "https://scryfall.com/contact"
    },
    "termsOfService": "https://scryfall.com/docs/terms",
    "x-logo": {
      "url": "https://scryfall.com/favicon.ico"
    }
  },
  "servers": [
    {
      "url": "https://api.scryfall.com",
      "description": "Production API Server"
    }
  ],
  "paths": {
    "/cards/search": {
      "get": {
        "summary": "Search for cards",
        "description": "Returns a List object containing Cards found using a fulltext search string. This search string supports the same fulltext search system that the main site uses.",
        "operationId": "searchCards",
        "tags": [
          "Cards"
        ],
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "description": "The fulltext search query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "c:red pow:3"
          },
          {
            "name": "unique",
            "in": "query",
            "description": "The strategy for omitting similar cards",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "cards",
                "art",
                "prints"
              ],
              "default": "cards"
            }
          },
          {
            "name": "order",
            "in": "query",
            "description": "The method to sort returned cards",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "name",
                "set",
                "released",
                "rarity",
                "color",
                "usd",
                "tix",
                "eur",
                "cmc",
                "power",
                "toughness",
                "edhrec",
                "artist"
              ],
              "default": "name"
            }
          },
          {
            "name": "dir",
            "in": "query",
            "description": "The direction to sort cards",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "auto",
                "asc",
                "desc"
              ],
              "default": "auto"
            }
          },
          {
            "name": "include_extras",
            "in": "query",
            "description": "If true, extra cards (tokens, planes, etc) will be included",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false
            }
          },
          {
            "name": "page",
            "in": "query",
            "description": "The page number to return",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful search results",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CardList"
                }
              }
            }
          },
          "400": {
            "description": "Bad request - invalid search query",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/cards/named": {
      "get": {
        "summary": "Get a card by name",
        "description": "Returns a Card based on a name search string. This method is designed for autocomplete and will return the best fuzzy match.",
        "operationId": "getCardByName",
        "tags": [
          "Cards"
        ],
        "parameters": [
          {
            "name": "exact",
            "in": "query",
            "description": "The exact card name to search for",
            "required": false,
            "schema": {
              "type": "string"
            },
            "example": "Lightning Bolt"
          },
          {
            "name": "fuzzy",
            "in": "query",
            "description": "A fuzzy card name to search for",
            "required": false,
            "schema": {
              "type": "string"
            },
            "example": "aust com"
          },
          {
            "name": "set",
            "in": "query",
            "description": "A set code to limit the search to one set",
            "required": false,
            "schema": {
              "type": "string"
            },
            "example": "m19"
          }
        ],
        "responses": {
          "200": {
            "description": "Card found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Card"
                }
              }
            }
          },
          "404": {
            "description": "Card not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/cards/{id}": {
      "get": {
        "summary": "Get a card by ID",
        "description": "Returns a single card with the given Scryfall ID",
        "operationId": "getCardById",
        "tags": [
