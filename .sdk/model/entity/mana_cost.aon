# Entity: mana_cost

main: kit: entity: mana_cost: {

  alias: field: {}

  fields: [
    {
      name: "cmc"
      req: false
      short: "The converted mana cost"
      type: "`$NUMBER`"
    }
    {
      name: "colorless"
      req: false
      short: "True if this mana cost is colorless"
      type: "`$BOOLEAN`"
    }
    {
      name: "colors"
      req: false
      short: "The colors in this mana cost"
      type: "`$ARRAY`"
    }
    {
      name: "cost"
      req: false
      short: "The normalized cost"
      type: "`$STRING`"
    }
    {
      name: "monocolored"
      req: false
      short: "True if this mana cost is monocolored"
      type: "`$BOOLEAN`"
    }
    {
      name: "multicolored"
      req: false
      short: "True if this mana cost is multicolored"
      type: "`$BOOLEAN`"
    }
    {
      name: "object"
      req: false
      short: "The object type"
      type: "`$STRING`"
    }
  ]

  name: "mana_cost"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            query: [
              {
                example: "{2}{U}{U}"
                kind: "query"
                name: "cost"
                orig: "cost"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/symbology/parse-mana"
          parts: [
            "symbology"
            "parse-mana"
          ]
          select: {
            exist: [
              "cost"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.colors`"
          }
        }
      ]
    }
  }



}
