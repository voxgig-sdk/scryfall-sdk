# Entity: card_list

main: kit: entity: card_list: {

  alias: field: {}

  fields: [
    {
      name: "artist"
      req: false
      short: "The name of the illustrator of this card"
      type: "`$STRING`"
    }
    {
      name: "cmc"
      req: false
      short: "The card's converted mana cost"
      type: "`$NUMBER`"
    }
    {
      name: "collector_number"
      req: false
      short: "This card's collector number"
      type: "`$STRING`"
    }
    {
      name: "color_identity"
      req: false
      short: "This card's color identity"
      type: "`$ARRAY`"
    }
    {
      name: "colors"
      req: false
      short: "This card's colors"
      type: "`$ARRAY`"
    }
    {
      name: "data"
      req: false
      short: "An array of the requested objects"
      type: "`$ARRAY`"
    }
    {
      name: "has_more"
      req: false
      short: "True if this list is paginated and has more pages"
      type: "`$BOOLEAN`"
    }
    {
      name: "id"
      req: false
      short: "A unique ID for this card in Scryfall's database"
      type: "`$STRING`"
    }
    {
      name: "identifiers"
      req: true
      type: "`$ARRAY`"
    }
    {
      name: "image_uris"
      req: false
      short: "An object containing URIs to this card's imagery"
      type: "`$OBJECT`"
    }
    {
      name: "lang"
      req: false
      short: "The language code for this printing"
      type: "`$STRING`"
    }
    {
      name: "layout"
      req: false
      short: "A code for this card's layout"
      type: "`$STRING`"
    }
    {
      name: "legalities"
      req: false
      short: "An object describing the legality of this card"
      type: "`$OBJECT`"
    }
    {
      name: "loyalty"
      req: false
      short: "This card's loyalty (for planeswalkers)"
      type: "`$STRING`"
    }
    {
      name: "mana_cost"
      req: false
      short: "The mana cost for this card"
      type: "`$STRING`"
    }
    {
      name: "name"
      req: false
      short: "The name of this card"
      type: "`$STRING`"
    }
    {
      name: "next_page"
      req: false
      short: "The URL for the next page of results"
      type: "`$STRING`"
    }
    {
      name: "object"
      req: false
      short: "The object type"
      type: "`$STRING`"
    }
    {
      name: "oracle_id"
      req: false
      short: "A unique ID for this card's oracle identity"
      type: "`$STRING`"
    }
    {
      name: "oracle_text"
      req: false
      short: "The Oracle text for this card"
      type: "`$STRING`"
    }
    {
      name: "power"
      req: false
      short: "This card's power (for creatures)"
      type: "`$STRING`"
    }
    {
      name: "prices"
      req: false
      short: "An object containing daily price information for this card"
      type: "`$OBJECT`"
    }
    {
      name: "rarity"
      req: false
      short: "This card's rarity"
      type: "`$STRING`"
    }
    {
      name: "released_at"
      req: false
      short: "The date this card was first released"
      type: "`$STRING`"
    }
    {
      name: "scryfall_uri"
      req: false
      short: "A link to this card's page on Scryfall's website"
      type: "`$STRING`"
    }
    {
      name: "set"
      req: false
      short: "This card's set code"
      type: "`$STRING`"
    }
    {
      name: "set_name"
      req: false
      short: "This card's full set name"
      type: "`$STRING`"
    }
    {
      name: "total_cards"
      req: false
      short: "The total number of cards found"
      type: "`$INTEGER`"
    }
    {
      name: "toughness"
      req: false
      short: "This card's toughness (for creatures)"
      type: "`$STRING`"
    }
    {
      name: "type_line"
      req: false
      short: "The type line of this card"
      type: "`$STRING`"
    }
    {
      name: "uri"
      req: false
      short: "A link to this card object on Scryfall's API"
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "card_list"
  op: {
    create: {
      name: "create"
      points: [
        {
          method: "POST"
          orig: "/cards/collection"
          parts: [
            "cards"
            "collection"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    list: {
      name: "list"
      points: [
        {
          args: {
            query: [
              {
                example: "auto"
                kind: "query"
                name: "dir"
                orig: "dir"
                reqd: false
                type: "`$STRING`"
              }
              {
                example: false
                kind: "query"
                name: "include_extra"
                orig: "include_extra"
                reqd: false
                type: "`$BOOLEAN`"
              }
              {
                example: "name"
                kind: "query"
                name: "order"
                orig: "order"
                reqd: false
                type: "`$STRING`"
              }
              {
                example: 1
                kind: "query"
                name: "page"
                orig: "page"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                example: "c:red pow:3"
                kind: "query"
                name: "q"
                orig: "q"
                reqd: true
                type: "`$STRING`"
              }
              {
                example: "cards"
                kind: "query"
                name: "unique"
                orig: "unique"
                reqd: false
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/cards/search"
          parts: [
            "cards"
            "search"
          ]
          select: {
            exist: [
              "dir"
              "include_extra"
              "order"
              "page"
              "q"
              "unique"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.data`"
          }
        }
      ]
    }
  }



}
