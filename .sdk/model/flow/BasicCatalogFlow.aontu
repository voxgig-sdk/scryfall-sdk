# BasicCatalogFlow

main: kit: flow: BasicCatalogFlow:
{
  entity: "catalog",
  kind: "basic",
  name: "BasicCatalogFlow",
  step: [
    {
      input: {
        ref: "catalog_ref01",
        srcdatavar: "catalog_ref01_data",
        suffix: "_dt0"
      }

      match: {
        id: "catalog01"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-catalog_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicCatalogFlow"
}